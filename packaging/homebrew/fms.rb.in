# Generated by packaging/homebrew/formula.sh for fms @VERSION@; do not edit.
class Fms < Formula
  desc "Flexibilitätsmanagementsystem: the grid operator's side of § 14a EnWG"
  homepage "https://hupe1980.github.io/fms/"
  license any_of: ["MIT", "Apache-2.0"]

  on_macos do
    on_arm do
      url "https://github.com/hupe1980/fms/releases/download/v@VERSION@/fms-v@VERSION@-aarch64-apple-darwin.tar.gz"
      sha256 "@SHA256_aarch64-apple-darwin@"
    end
  end

  on_linux do
    # Statically linked (musl): no dependency on the host's glibc.
    on_arm do
      url "https://github.com/hupe1980/fms/releases/download/v@VERSION@/fms-v@VERSION@-aarch64-unknown-linux-musl.tar.gz"
      sha256 "@SHA256_aarch64-unknown-linux-musl@"
    end
    on_intel do
      url "https://github.com/hupe1980/fms/releases/download/v@VERSION@/fms-v@VERSION@-x86_64-unknown-linux-musl.tar.gz"
      sha256 "@SHA256_x86_64-unknown-linux-musl@"
    end
  end

  def install
    bin.install "fms"
    doc.install "README.md", "CHANGELOG.md"
  end

  def caveats
    <<~EOS
      Run a reference day — a January cold snap, with and without the FMS:
        fms sim cold-snap
      Every day at once:
        fms sim all
    EOS
  end

  test do
    assert_match "fms #{version}", shell_output("#{bin}/fms --version")
    # The Mindestleistung of BK6-22-300 Ziff. 4.5.2 for a 9 kW heat pump and an 11 kW wallbox.
    assert_match "7.56 kW", shell_output("#{bin}/fms floor heat-pump:9 wallbox:11")
    assert_match "below the floor 0", shell_output("NO_COLOR=1 #{bin}/fms sim pv-noon")
  end
end
